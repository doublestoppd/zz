# Runtime configuration for the server container (docs/OPERATIONS.md, "Configuration").
# Copy to .env; .env is git-ignored. Anything secret is set here or in the host's secret
# store, never in the image or the source tree.

# Browser origins allowed to open a socket. Required in production.
ALLOWED_ORIGINS=https://play.example

# Enables GET /admin/matches for operators. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Behind a reverse proxy that sets X-Forwarded-For (1) or exposed directly (unset).
TRUST_PROXY=1

# Capacity for this host.
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_ADDRESS=16
MAX_MATCHES=100

# debug, info, warn, error
LOG_LEVEL=info
# critical (production) or full (staging)
INVARIANT_CHECKS=critical
