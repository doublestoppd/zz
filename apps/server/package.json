{
  "name": "@zombie/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative match server: sessions, lobby, and WebSocket transport.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "replay": "tsx src/replay/cli.ts",
    "soak": "tsx src/soak/cli.ts",
    "bench": "tsx src/bench/cli.ts",
    "record-golden": "tsx src/soak/cli.ts --matches 2 --seed 1 --journals fixtures/golden --failures soak-failures"
  },
  "dependencies": {
    "@zombie/game-core": "workspace:*",
    "@zombie/game-data": "workspace:*",
    "@zombie/map-generation": "workspace:*",
    "@zombie/protocol": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13"
  }
}
