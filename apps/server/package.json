{
  "name": "@zombie/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative match server: sessions, lobby, and WebSocket transport.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zombie/game-core": "workspace:*",
    "@zombie/game-data": "workspace:*",
    "@zombie/protocol": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13"
  }
}
